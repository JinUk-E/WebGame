--- !u!114 &485091940
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 485091938}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9d82d8dc4cfe1442a96866b00baeff0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Morae.Game::Morae.Game.Core.PrologueDirector
  linePauseSec: 0.4
  lines:
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC624\uB298 \uBC24\u2026 \uADF8\uAC83\uC774 \uB110 \uCC3E\uC544\uC62C
      \uAC8C\uB2E4."
    duration: 3.5
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC774 \uBC29\uC5D0\uC11C \uB098\uAC00\uC9C0 \uB9C8\uB77C. \uB124 \uADC0\uD241\uC774\uC758
      \uC18C\uAE08\uC774 \uACB0\uACC4\uB2E4 \u2014 \uAC80\uAC8C \uBB3C\uB4E4\uBA74
      \uBD88\uC0C1 \uC55E\uC5D0\uC11C \uAE30\uB3C4\uD574\uB77C."
    duration: 5
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uBD80\uC801\uC740 \uB110 \uD55C \uBC88\uB9CC \uB300\uC2E0 \uC9C0\uCF1C\uC900\uB2E4.
      \uBD80\uC801\uC774 \uAC80\uAC8C \uD0C0\uBA74\u2026 \uADF8\uAC8C \uB9C8\uC9C0\uB9C9
      \uACBD\uACE0\uB2E4."
    duration: 4.5
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uBA85\uC2EC\uD574\uB77C. \uBB38\uC774 \uC7A0\uAE34 \uB4A4, \uBB38\uBC16\uC5D0\uC11C
      \uB4E4\uB9AC\uB294 \uC18C\uB9AC\uB294 \uC804\uBD80 \uC758\uC2EC\uD574\uB77C.
      \uADF8\uAC83\uC740 \uBAA9\uC18C\uB9AC\uB97C \uD6D4\uCE5C\uB2E4."
    duration: 5
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC9C4\uC9DC \uC544\uCE68\uC740 \uC18C\uB9AC\uAC00 \uC544\uB2C8\uB77C
      \uBE5B\uC73C\uB85C \uC628\uB2E4. \uCC3D\uBC16\uC774 \uBC1D\uC544\uC57C \uC544\uCE68\uC774\uB2E4.
      \uC2DC\uACC4\uB3C4 \uBBFF\uC9C0 \uB9C8\uB77C."
    duration: 5
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "07\uC2DC \uBC18, \uD560\uBA48\uACFC \uD568\uAED8 \uB370\uB9AC\uB7EC \uC624\uB9C8.
      \uADF8\uB54C\uAE4C\uC9C0\u2026 \uBC84\uD168\uB77C."
    duration: 4
  - speaker: "\uB098"
    text: "(\uAC78\uC1E0\uB97C \uAC78\uC5C8\uB2E4. \uC774\uC81C \uC774 \uBC29\uC774
      \uC804\uBD80\uB2E4.)"
    duration: 3
