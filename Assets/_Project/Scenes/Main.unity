--- !u!114 &485091940
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 485091938}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9d82d8dc4cfe1442a96866b00baeff0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Morae.Game::Morae.Game.Core.PrologueDirector
  linePauseSec: 0.4
  lines:
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\u2026\uC544\uAE4C \uB2F4\uC7A5 \uC704\uC5D0\uC11C \uBCF8 \uAC78 \uB9D0\uD574\uBD10\uB77C.
      \uD0A4\uAC00 2\uBBF8\uD130\uB294 \uB418\uACE0, \uD770 \uC6D0\uD53C\uC2A4\uC5D0
      '\uD3EC\uD3EC\uD3EC' \uC18C\uB9AC\uB97C \uB0C8\uB2E4\uACE0 \uD588\uB0D0?"
    duration: 5
  - speaker: "\uB098"
    text: "\uB124, \uD560\uC544\uBC84\uC9C0\u2026 \uB0A8\uC790\uAC00 \uC5EC\uC7A5\uD55C
      \uAC74\uAC00 \uC2F6\uC5B4\uC11C \uB9D0\uC500\uB4DC\uB9B0 \uAC74\uB370, \uC65C
      \uADF8\uB807\uAC8C \uBB34\uC12D\uAC8C \uB178\uBC1C\uB300\uBC1C\uD558\uC138\uC694?"
    duration: 4.5
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uCBE7, \uD070\uC77C \uB0AC\uAD6C\uB098\u2026 \uADF8\uAC74 \uC0AC\uB78C\uC774
      \uC544\uB2C8\uB2E4. \uC774 \uB3D9\uB124\uC5D0 \uBD09\uC778\uB418\uC5B4 \uC788\uB358
      '\uD314\uCC99\uB2D8'\uC774\uC57C."
    duration: 5
  - speaker: "\uB098"
    text: "\uD314\uCC99\uB2D8\uC694\u2026? \uADF8\uAC8C \uBB54\uB370\uC694? \uD560\uBA38\uB2C8\uB294
      \uC65C \uC606\uC5D0\uC11C \uB5A8\uACE0 \uACC4\uC138\uC694?"
    duration: 3.5
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uADF8\uB188 \uB9C8\uC74C\uC5D0 \uB4E4\uBA74 \uC774\uD2BF\uB0A0\uC744
      \uBABB \uB118\uAE30\uACE0 \uC8FD\uB294\uB2E4! \uC624\uB298\uC740 \uC808\uB300
      \uC9D1\uC5D0 \uB3CC\uC544\uAC08 \uC0DD\uAC01 \uB9C8\uB77C."
    duration: 5
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC774 \uBC29 \uCC3D\uBB38\uC740 \uC2E0\uBB38\uC9C0\uC640 \uBD80\uC801\uC73C\uB85C
      \uB9C9\uC558\uACE0, \uB124 \uADC0\uD241\uC774\uC5D0 \uC18C\uAE08\uC744 \uC313\uC558\uB2E4.
      \uC18C\uAE08\uC774 \uB354\uB7EC\uC6CC\uC9C0\uBA74 \uC800 \uBD80\uC801\uC774
      \uB300\uC2E0 \uD0C0\uB4E4\uC5B4\uAC04\uB2E4 \u2014 \uB2E4 \uD0C0\uBA74 \uB05D\uC774\uC57C."
    duration: 5.5
  - speaker: "\uB098"
    text: "\uADF8\uB7FC \uC804 \uC544\uCE68\uAE4C\uC9C0 \uC774 \uBC29\uC5D0 \uAC07\uD600
      \uC788\uC5B4\uC57C \uD558\uB294 \uAC70\uC608\uC694?"
    duration: 3.5
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uADF8\uB798. \uBB38\uBC16\uC5D0\uC11C \uB0B4 \uBAA9\uC18C\uB9AC\uAC00
      \uB4E4\uB824\uB3C4 \uC808\uB300 \uC5F4\uC9C0 \uB9C8\uB77C. \uADF8\uB188\uC740
      \uC0AC\uB78C \uBAA9\uC18C\uB9AC\uB97C \uD6D4\uCCD0 \uC720\uD639\uD558\uB294
      \uB188\uC774\uB2E4."
    duration: 5.5
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC2DC\uACC4\uB098 \uC18C\uB9AC\uB294 \uBBFF\uC9C0 \uB9D0\uACE0, \uCC3D\uBC16\uC774
      \uD658\uD558\uAC8C \uBC1D\uC544\uC624\uBA74 \uADF8\uB54C \uC77C\uACF1 \uC2DC
      \uBC18\uC5D0 \uB0B4\uAC00 \uC9C1\uC811 \uB370\uB9AC\uB7EC \uC624\uB9C8."
    duration: 5.5
  - speaker: "\uB098"
    text: "(\uBB38\uC774 \uB2EB\uD788\uACE0 \uAC78\uC1E0\uB97C \uC7A0\uAC14\uB2E4.
      \uBC29 \uC548\uC5D0\uB294 \uCE68\uBB35\uACFC \uAE30\uBB18\uD55C \uC815\uC801\uB9CC\uC774
      \uB0A8\uC544\uC788\uB2E4.)"
    duration: 4
  linesAfterTraining: 1
  config: {fileID: 11400000, guid: 94b5dc86590437d44b3fc3c6aa682afa, type: 2}
  scheduler: {fileID: 638019703}
  trainingCorner: 1
  warningLine:
    speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC18C\uAE08\uC774 \uAC80\uC5B4\uC9C0\uBA74 \uADF8\uCABD\uC73C\uB85C \uAE38\uC774
      \uC5F4\uB9B0\uB2E4. \uB124 \uACF3\uC774 \uB2E4 \uC5F4\uB9AC\uBA74 \uB05D\uC774\uC57C."
    duration: 5.5
  controlHintLine:
    speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uB9C9\uB294 \uBC95\uC740 \uC774\uB807\uB2E4. \uAC80\uC5B4\uC9C4 \uC790\uB9AC\uB85C
      \uC9C1\uC811 \uAC00\uC11C, \uADF8 \uC790\uB9AC\uC5D0 \uC18C\uAE08\uC744 \uB2E4\uC2DC
      \uB20C\uB7EC \uB2F4\uC544\uB77C."
    duration: 4.5
  telegraphLine:
    speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\u2026\uC27F. \uBC8C\uC368 \uD55C\uCABD\uC774 \uB4E4\uC369\uC778\uB2E4.
      \uC800\uAE30\uB2E4, \uC800\uB9AC\uB85C \uAC00\uC11C \uB2F4\uC544\uB77C. \uC5B4\uC11C!"
    duration: 4.5
  retryLine:
    speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uAD1C\uCC2E\uB2E4, \uC544\uC9C1\uC740 \uB0B4\uAC00 \uBD99\uC7A1\uACE0
      \uC788\uB2E4. \uB2E4\uC2DC \u2014 \uC18C\uB9AC \uB098\uB294 \uCABD\uC73C\uB85C
      \uAC00\uAC70\uB77C."
    duration: 3.5
  clearedLine:
    speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uADF8\uB807\uC9C0. \uADF8\uB807\uAC8C \uB9C9\uB294 \uAC70\uB2E4. \uC774\uC81C
      \uD63C\uC790\uC11C\uB3C4 \uD560 \uC218 \uC788\uACA0\uC9C0."
    duration: 4
  mercyLine:
    speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\u2026\uC774\uBC88\uC5D4 \uB0B4\uAC00 \uB9C9\uC558\uB2E4. \uB2E4\uC74C\uC5D4
      \uB124\uAC00 \uD574\uC57C \uD574. \uAC80\uC5B4\uC9C4 \uC790\uB9AC\uB85C \uAC00\uC11C,
      \uC190\uC73C\uB85C \uB20C\uB7EC \uB2F4\uB294 \uAC70\uB2E4."
    duration: 5
  saltCueLineIndex: 5
  altarHighlightExtraSec: 2.5
  trainingTelegraphSec: 6
  saltCueStepSec: 0.32
  saltCueHoldSec: 0.55
  skipZoneViewport:
    serializedVersion: 2
    x: 0.8
    y: 0.88
    width: 0.2
    height: 0.12
  fallbackLineMinShowSec: 0.3
  inputHandoffGraceSec: 0.2
