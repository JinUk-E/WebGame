    channel: 0
    audioClipMuffled: {fileID: 8300000, guid: ac08920b5b2cab140a8388c3d45f4083, type: 3}
    subtitleLines:
    - speaker: ???
      text: "\uC598\uC57C! \uD560\uC560\uBE44\uB2E4! \uBC8C\uC368 \uC544\uCE68\uC774\uC57C,
        \uC5B4\uC11C \uBB38 \uC5F4\uC5B4\uB77C! \uC2DC\uACC4\uB97C \uBCF4\uAC70\uB77C!"
