    audioClip: {fileID: 0}
    channel: 0
    audioClipMuffled: {fileID: 0}
    subtitleLines:
    - speaker: 
      text: "(\uC190\uC7A1\uC774\uAC00 \uB35C\uCEF9\uAC70\uB9B0\uB2E4 \u2014 \uC804\uD654\uBCA8
        \u2014 \uB178\uD06C \uC18C\uB9AC\uAC00 \uB3D9\uC2DC\uC5D0 \uC6B8\uB9B0\uB2E4)"
