    channel: 2
    audioClipMuffled: {fileID: 0}
    subtitleLines:
    - speaker: "\uB098"
      text: "\u2026\uC544\uB7AB\uBC30\uAC00 \uBB34\uAC81\uB2E4. \uC5B8\uC81C\uAE4C\uC9C0
