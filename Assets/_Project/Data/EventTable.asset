    channel: 1
    audioClipMuffled: {fileID: 0}
    subtitleLines:
    - speaker: 
      text: "(\uC720\uB9AC\uCC3D\uC774 \uB4DC\uB974\uB975 \uB5A8\uB9B0\uB2E4)"
